<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd"><system><section id="payment"><group id="lunixi" translate="label" type="text" sortOrder="800" showInDefault="1" showInWebsite="1" showInStore="1"><label>Lunixi Payments</label>
<field id="active" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1"><label>Enable Lunixi</label><source_model>Magento\Config\Model\Config\Source\Yesno</source_model></field>
<field id="title" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1"><label>Checkout title</label></field>
<field id="merchant_id" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1"><label>Merchant ID</label></field>
<field id="key_id" translate="label" type="obscure" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1"><label>Merchant SECRET key identifier</label><backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model></field>
<field id="private_key" translate="label comment" type="obscure" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1"><label>Ed25519 PKCS8 private key</label><comment>Paste base64 PKCS8 DER, or PEM with literal \n line separators. The value is encrypted and never returned to the browser.</comment><backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model></field>
<field id="webhook_secret" translate="label" type="obscure" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1"><label>Webhook signing secret</label><backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model></field>
<field id="hosted" translate="label comment" type="select" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1"><label>Use optional hosted checkout</label><comment>Disabled by default: the existing Lunixi form opens on this store. Enable to redirect using the backend paymentPageUrl. Payment methods are managed in the Lunixi panel.</comment><source_model>Magento\Config\Model\Config\Source\Yesno</source_model></field>
<field id="preauth" translate="label" type="select" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1"><label>Authorize now, capture later</label><source_model>Magento\Config\Model\Config\Source\Yesno</source_model></field>
<field id="instructions" type="note" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1"><frontend_model>Lunixi\Payments\Block\Adminhtml\Instructions</frontend_model></field>
</group></section></system></config>
